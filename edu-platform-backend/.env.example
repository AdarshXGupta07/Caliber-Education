# ─── Supabase ───────────────────────────────────────────────────────────────
# Find both values in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ─── JWT ────────────────────────────────────────────────────────────────────
# Any long random string — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_super_secret_jwt_key_replace_this_with_random_64_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ─── Razorpay ────────────────────────────────────────────────────────────────
# Get from: razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Get from: razorpay.com → Settings → Webhooks (set the webhook URL to
# https://your-backend-host/api/payments/webhook, subscribe to "payment.captured")
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ─── Cloudflare Turnstile ────────────────────────────────────────────────────
# Get from: dash.cloudflare.com → Turnstile → your site → Secret Key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# ─── SendGrid (Optional — for real OTP emails) ───────────────────────────────
# Without this, OTP will be printed to server logs in dev mode (value: 123456)
# Get from: sendgrid.com → Settings → API Keys
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@calibereducation.com
# Where contact-form submissions get forwarded — change to a real support inbox later
CONTACT_NOTIFICATION_EMAIL=adarshguptaa1108@gmail.com

# ─── Supabase Storage ────────────────────────────────────────────────────────
# The bucket names you create in Supabase → Storage
SUPABASE_SUBMISSION_BUCKET=test-submissions
SUPABASE_EVALUATION_BUCKET=evaluated-papers

# ─── Maintenance ─────────────────────────────────────────────────────────────
# Shared secret for the scheduled 7-day file purge (GitHub Actions calls the
# endpoint with this in an X-Maintenance-Secret header). Generate with:
#   python -c "import secrets; print(secrets.token_hex(24))"
MAINTENANCE_SECRET=

# ─── App Settings ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Fail-closed default is "production" — set this to "development" explicitly
# in your local .env only. Never set it to "development" on a deployed host.
APP_ENV=development

# Set to "true" only for local/manual testing of the payment flow without a
# real Razorpay transaction — it enables the require_admin-gated
# /mock-confirm* endpoints. MUST be unset or "false" on any deployed
# (production) host: if true there, any admin account can grant itself or
# anyone free course/MCQ/test-series access, permanently, bypassing Razorpay
# entirely.
ALLOW_TEST_PAYMENTS=false

# NOTE: Google OAuth is configured in the Supabase dashboard (Authentication
# -> Providers -> Google), not here — this backend never handles a Google
# client secret directly, it only validates the token Supabase already issued.
